{
  "n": 512,
  "seed": 1,
  "target": "sine",
  "optimizer": "ssbroyden",
  "coordinates": "individual",
  "eta": 0.001,
  "initialization": "reference_xavier",
  "slope_initialization": "physical_xavier",
  "epsilon": 1e-15,
  "beta1": 0.9,
  "beta2": 0.999,
  "ema_alpha": 0.98,
  "ema_strength": 0.0,
  "ema_location": 1,
  "ema_normalized": false,
  "sampling": "full",
  "batch_size": 1024,
  "schedule": "constant",
  "reset": "none",
  "reset_graph": "shared",
  "curvature_epsilon": 1e-30,
  "metric_reset": "non_descent",
  "reset_interval": 1000
}
