# ---------------------------------------------------------------------------
# Essay Collections — environment variables
# Copy to `.env.local` for local dev, and set the same values in the Vercel
# project settings for production. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ------------------------------------
# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never expose to the client. Used only in server actions / cron for
# privileged admin + moderation operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
# The canonical URL of the deployment (used for OAuth redirects, absolute
# links, and the cron user-agent). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name / branding. Change these two to rebrand the whole site.
NEXT_PUBLIC_SITE_NAME=Essay Collections
NEXT_PUBLIC_SITE_TAGLINE=A collection of essays by faithful Latter-day Saints.

# --- Bootstrapping the first admin -----------------------------------------
# Comma-separated Google account emails that are auto-granted admin on first
# sign-in (only while under the 20-admin cap). After launch, admins are managed
# in-app. Leave empty once your admins are established.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- Moderation bot (Anthropic) --------------------------------------------
# SERVER-ONLY. Powers the daily guideline-compliance scan.
ANTHROPIC_API_KEY=sk-ant-your-key
# Model the moderation bot uses. Defaults to claude-opus-5 (best judgment; it
# runs once daily so cost is small). Set to claude-haiku-4-5 to minimize cost.
MODERATION_MODEL=claude-opus-5

# Shared secret that authorizes the cron endpoint. Generate a long random
# string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string
