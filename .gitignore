results/**
# but keep ALL markdown under results/ tracked -- writeups, method docs, specs.
# (The old *_results.md-only rule is how four load-bearing docs nearly got
# lost in July 2026; docs now live in results/ next to their writeups.)
!results/**/
!results/**/*.md
# track long-form HTML explainers alongside the writeups
!results/**/*.html
# track figures/images everywhere under results/ (but never data or caches)
!results/**/*.png
!results/**/*.jpg
!results/**/*.jpeg
!results/**/*.gif
!results/**/*.svg
!results/**/*.webp
# track the expD02 cube data (source of the init_slice / training_slice figures)
!results/checkpoint_D_optimizers/expD02_adam_geometry/cube.json
# ...but never the bulky coefficient-evolution gif dirs (expD06 etc.)
results/**/gifs/
checkpoints/
data/
wandb/
__pycache__/
*.egg-info/
.venv/
*.pyc
.DS_Store
*.ipynb_checkpoints/
.claude/
*.ipynb
# but track the 2D geometry visualizer notebook (only this one)
!results/checkpoint_E_2d/expE01_geometry_zoo_2d/geometry_viz.ipynb
